TOOLDAWN_ENVIRONMENT=development
# seed is a read-only development mode. Production requires postgres.
TOOLDAWN_CATALOG_BACKEND=seed
# Required when TOOLDAWN_CATALOG_BACKEND=postgres
# Direct remote connections; supply real credentials privately.
# TOOLDAWN_DATABASE_URL=postgresql+asyncpg://tooldawn:CHANGE_ME@154.201.90.159:25432/tooldawn
# TOOLDAWN_TEST_DATABASE_URL=postgresql+asyncpg://tooldawn_test:CHANGE_ME@154.201.90.159:25432/tooldawn_test
# TOOLDAWN_REDIS_URL=redis://tooldawn:CHANGE_ME@154.201.90.159:26379/0
# Generate a private random secret with scripts/setup-auth.ps1.
# TOOLDAWN_AUTH_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
TOOLDAWN_PUBLIC_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
TOOLDAWN_MAIL_MODE=file
TOOLDAWN_MAIL_OUTBOX=../../.runtime/mail
# Production: MAIL_MODE=smtp, HTTPS origins and the SMTP options below.
# TOOLDAWN_SMTP_HOST=smtp.example.com
# TOOLDAWN_SMTP_PORT=587
# TOOLDAWN_SMTP_SECURITY=starttls
# TOOLDAWN_SMTP_USERNAME=
# TOOLDAWN_SMTP_PASSWORD=
# TOOLDAWN_SMTP_FROM=ToolDawn <noreply@example.com>

# Payments stay disabled until BOTH Stripe secrets and credit packages are configured.
# Use test credentials in development. Never commit real secrets.
# TOOLDAWN_STRIPE_SECRET_KEY=sk_test_REPLACE_PRIVATELY
# TOOLDAWN_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_PRIVATELY
TOOLDAWN_BILLING_ORIGIN=http://127.0.0.1:3000
TOOLDAWN_CREDIT_PACKAGES=[]
# Test example only: [{"id":"test-100","credits":100,"unit_amount":500,"currency":"usd"}]
# unit_amount uses the currency's minor unit, e.g. 500 = USD 5.00.

# Prompt tools: a Chat Completions compatible provider.
# Base URL includes the version path; /chat/completions is appended once.
# Never put these credentials in frontend environment variables.
# TOOLDAWN_LLM_BASE_URL=https://your-provider.example/v1
# TOOLDAWN_LLM_API_KEY=REPLACE_PRIVATELY
# TOOLDAWN_LLM_MODEL=your-text-model
TOOLDAWN_AI_TOOL_COST=1
